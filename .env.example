# 复制为 .env 后填写。也可以直接复用引擎根目录的 .env（程序会自动向上找）。
# DeepSeek（Anthropic 兼容入口，默认）
ANTHROPIC_API_KEY=sk-你的key
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
MODEL_ID=deepseek-v4-pro

# 想省钱可换：deepseek-v4-flash
# 可换源（均需 Anthropic 兼容端点），例：
# ANTHROPIC_BASE_URL=https://api.moonshot.cn/anthropic   MODEL_ID=kimi-k2.7-code
# ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic MODEL_ID=glm-5.2
